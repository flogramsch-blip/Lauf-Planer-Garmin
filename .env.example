# OpenRouteService API-Key (kostenlos: https://openrouteservice.org/dev/#/signup)
# Wird serverseitig fuer das Routing (Rundkurs-Generierung) verwendet.
ORS_API_KEY=

# Anthropic API-Key (https://console.anthropic.com/)
# Optional: nur noetig fuer die KI-Schicht (Freitext -> Routing-Parameter).
# Ohne diesen Key funktionieren die Slider weiterhin.
ANTHROPIC_API_KEY=

# Optionales Modell-Override fuer die Intent-Extraktion.
# Default: claude-haiku-4-5 (schnell & guenstig).
ANTHROPIC_MODEL=claude-haiku-4-5
